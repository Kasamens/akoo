": "Berlin.", "s": 39.157, "e": 39.843}, {"t": "Ich", "s": 40.285, "e": 40.606}, {"t": "bin", "s": 40.621, "e": 40.834}, {"t": "neu", "s": 40.849, "e": 41.139}, {"t": "hier.", "s": 41.154, "e": 41.642}], "end": 42.084}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Arbeitest du hier?", "en": "Do you work here?", "start": 42.584, "words": [{"t": "Arbeitest", "s": 42.695, "e": 43.488}, {"t": "du", "s": 43.503, "e": 43.686}, {"t": "hier?", "s": 43.701, "e": 44.189}], "end": 45.248}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Ja, ich arbeite in Berlin. Ich bin Ingenieur. Und ich lerne Deutsch.", "en": "Yes, I work in Berlin. I'm an engineer. And I'm learning German.", "start": 45.748, "words": [{"t": "Ja,", "s": 45.798, "e": 46.332}, {"t": "ich", "s": 46.743, "e": 47.002}, {"t": "arbeite", "s": 47.017, "e": 47.658}, {"t": "in", "s": 47.673, "e": 47.825}, {"t": "Berlin.", "s": 47.841, "e": 48.527}, {"t": "Ich", "s": 48.969, "e": 49.319}, {"t": "bin", "s": 49.335, "e": 49.624}, {"t": "Ingenieur.", "s": 49.639, "e": 50.585}, {"t": "Und", "s": 51.027, "e": 51.423}, {"t": "ich", "s": 51.438, "e": 51.636}, {"t": "lerne", "s": 51.652, "e": 52.094}, {"t": "Deutsch.", "s": 52.109, "e": 52.734}], "end": 53.188}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Ich lerne auch. Ich lerne Spanisch! Ich bin Lehrerin.", "en": "I'm learning too. I'm learning Spanish! I'm a teacher.", "start": 53.688, "words": [{"t": "Ich", "s": 53.799, "e": 54.043}, {"t": "lerne", "s": 54.058, "e": 54.531}, {"t": "auch.", "s": 54.546, "e": 55.049}, {"t": "Ich", "s": 56.127, "e": 56.371}, {"t": "lerne", "s": 56.386, "e": 56.843}, {"t": "Spanisch!", "s": 56.859, "e": 57.682}, {"t": "Ich", "s": 58.734, "e": 58.993}, {"t": "bin", "s": 59.008, "e": 59.282}, {"t": "Lehrerin.", "s": 59.298, "e": 60.136}], "end": 61.2}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Bist du müde, Kofi?", "en": "Are you tired, Kofi?", "start": 61.7, "words": [{"t": "Bist", "s": 61.811, "e": 62.131}, {"t": "du", "s": 62.146, "e": 62.299}, {"t": "müde,", "s": 62.314, "e": 62.848}, {"t": "Kofi?", "s": 63.091, "e": 63.686}], "end": 64.748}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Ja, ich bin müde. Und ich habe Hunger.", "en": "Yes, I'm tired. And I'm hungry.", "start": 65.248, "words": [{"t": "Ja,", "s": 65.298, "e": 65.832}, {"t": "ich", "s": 66.121, "e": 66.289}, {"t": "bin", "s": 66.304, "e": 66.548}, {"t": "müde.", "s": 66.563, "e": 67.143}, {"t": "Und", "s": 67.585, "e": 68.027}, {"t": "ich", "s": 68.042, "e": 68.194}, {"t": "habe", "s": 68.21, "e": 68.56}, {"t": "Hunger.", "s": 68.575, "e": 69.185}], "end": 69.64}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Ich habe auch Hunger! Hast du heute Zeit?", "en": "I'm hungry too! Do you have time today?", "start": 70.14, "words": [{"t": "Ich", "s": 70.251, "e": 70.495}, {"t": "habe", "s": 70.51, "e": 70.998}, {"t": "auch", "s": 71.013, "e": 71.288}, {"t": "Hunger!", "s": 71.303, "e": 71.897}, {"t": "Hast", "s": 72.975, "e": 73.356}, {"t": "du", "s": 73.372, "e": 73.539}, {"t": "heute", "s": 73.555, "e": 74.012}, {"t": "Zeit?", "s": 74.027, "e": 74.576}], "end": 75.636}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Ja, ich habe heute Zeit.", "en": "Yes, I have time today.", "start": 76.136, "words": [{"t": "Ja,", "s": 76.243, "e": 76.654}, {"t": "ich", "s": 77.066, "e": 77.188}, {"t": "habe", "s": 77.203, "e": 77.508}, {"t": "heute", "s": 77.523, "e": 77.935}, {"t": "Zeit.", "s": 77.95, "e": 78.545}], "end": 78.992}, {"kind": "pause", "dur": 1.0, "start": 79.492, "end": 80.492}, {"kind": "section", "text": "Was hast du gehört?", "start": 80.492, "end": 80.492}, {"kind": "host", "spk": "H", "name": "Host", "text": "Same verb, two endings. Kofi about himself:", "en": "", "start": 80.492, "words": [{"t": "Same", "s": 80.621, "e": 81.003}, {"t": "verb,", "s": 81.016, "e": 81.476}, {"t": "two", "s": 81.753, "e": 82.003}, {"t": "endings.", "s": 82.016, "e": 82.713}, {"t": "Kofi", "s": 83.095, "e": 83.701}, {"t": "about", "s": 83.714, "e": 84.056}, {"t": "himself:", "s": 84.069, "e": 84.832}], "end": 85.22}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Ich wohne in Berlin.", "en": "I live in Berlin.", "start": 85.72, "words": [{"t": "Ich", "s": 85.77, "e": 86.136}, {"t": "wohne", "s": 86.151, "e": 86.669}, {"t": "in", "s": 86.685, "e": 86.868}, {"t": "Berlin.", "s": 86.883, "e": 87.599}], "end": 88.048}, {"kind": "host", "spk": "H", "name": "Host", "text": "Lena, asking Kofi:", "en": "", "start": 88.548, "words": [{"t": "Lena,", "s": 88.677, "e": 89.256}, {"t": "asking", "s": 89.519, "e": 90.006}, {"t": "Kofi:", "s": 90.019, "e": 90.69}], "end": 91.092}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Wo wohnst du?", "en": "Where do you live?", "start": 91.592, "words": [{"t": "Wo", "s": 91.703, "e": 92.008}, {"t": "wohnst", "s": 92.023, "e": 92.48}, {"t": "du?", "s": 92.496, "e": 92.74}], "end": 93.8}, {"kind": "host", "spk": "H", "name": "Host", "text": "The ending tells you who. Here's the whole pattern. Listen to the ends.", "en": "", "start": 94.3, "words": [{"t": "The", "s": 94.442, "e": 94.626}, {"t": "ending", "s": 94.639, "e": 95.047}, {"t": "tells", "s": 95.061, "e": 95.403}, {"t": "you", "s": 95.416, "e": 95.574}, {"t": "who.", "s": 95.587, "e": 96.021}, {"t": "Here's", "s": 96.445, "e": 96.721}, {"t": "the", "s": 96.734, "e": 96.826}, {"t": "whole", "s": 96.839, "e": 97.129}, {"t": "pattern.", "s": 97.142, "e": 97.774}, {"t": "Listen", "s": 98.195, "e": 98.655}, {"t": "to", "s": 98.668, "e": 98.8}, {"t": "the", "s": 98.813, "e": 98.997}, {"t": "ends.", "s": 99.011, "e": 99.563}], "end": 99.964}, {"kind": "line", "spk": "L", "name": "Lena", "text": "ich wohne.", "en": "I live.", "start": 100.464, "words": [{"t": "ich", "s": 100.575, "e": 100.834}, {"t": "wohne.", "s": 100.849, "e": 101.352}], "end": 102.408}, {"kind": "pause", "dur": 0.6, "start": 102.908, "end": 103.508}, {"kind": "line", "spk": "L", "name": "Lena", "text