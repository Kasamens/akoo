{"title": "Verben im Präsens", "en": "Kofi meets Lena: ich wohne, du wohnst", "level": "A1", "lines": [{"kind": "section", "text": "Intro", "start": 0.0, "end": 0.0}, {"kind": "host", "spk": "H", "name": "Host", "text": "Welcome to Akoo, episode one: verbs in the present tense.", "en": "", "start": 0.0, "words": [{"t": "Welcome", "s": 0.142, "e": 0.642}, {"t": "to", "s": 0.655, "e": 0.826}, {"t": "Akoo,", "s": 0.839, "e": 1.353}, {"t": "episode", "s": 1.563, "e": 2.076}, {"t": "one:", "s": 2.089, "e": 2.432}, {"t": "verbs", "s": 2.787, "e": 3.195}, {"t": "in", "s": 3.208, "e": 3.3}, {"t": "the", "s": 3.313, "e": 3.418}, {"t": "present", "s": 3.432, "e": 3.879}, {"t": "tense.", "s": 3.892, "e": 4.497}], "end": 4.896}, {"kind": "host", "spk": "H", "name": "Host", "text": "Just listen first. Kofi is from Ghana, and he's new in Berlin. In a café, he meets Lena.", "en": "", "start": 5.396, "words": [{"t": "Just", "s": 5.497, "e": 5.879}, {"t": "listen", "s": 5.892, "e": 6.274}, {"t": "first.", "s": 6.287, "e": 6.945}, {"t": "Kofi", "s": 7.328, "e": 7.907}, {"t": "is", "s": 7.92, "e": 8.105}, {"t": "from", "s": 8.118, "e": 8.328}, {"t": "Ghana,", "s": 8.341, "e": 8.868}, {"t": "and", "s": 9.118, "e": 9.236}, {"t": "he's", "s": 9.249, "e": 9.447}, {"t": "new", "s": 9.46, "e": 9.736}, {"t": "in", "s": 9.749, "e": 9.907}, {"t": "Berlin.", "s": 9.92, "e": 10.526}, {"t": "In", "s": 10.949, "e": 11.067}, {"t": "a", "s": 11.08, "e": 11.146}, {"t": "café,", "s": 11.159, "e": 11.764}, {"t": "he", "s": 12.001, "e": 12.12}, {"t": "meets", "s": 12.133, "e": 12.449}, {"t": "Lena.", "s": 12.462, "e": 12.975}], "end": 13.364}, {"kind": "pause", "dur": 1.0, "start": 13.864, "end": 14.864}, {"kind": "section", "text": "Szene 1 · Im Café", "start": 14.864, "end": 14.864}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Hallo! Ich bin Lena. Und du?", "en": "Hi! I'm Lena. And you?", "start": 14.864, "words": [{"t": "Hallo!", "s": 14.975, "e": 15.661}, {"t": "Ich", "s": 16.709, "e": 16.