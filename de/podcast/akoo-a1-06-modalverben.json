 17.001}, {"t": "gern!", "s": 17.245, "e": 17.809}, {"t": "Ich", "s": 18.251, "e": 18.586}, {"t": "möchte", "s": 18.602, "e": 19.028}, {"t": "Deutsch", "s": 19.044, "e": 19.44}, {"t": "sprechen.", "s": 19.455, "e": 20.187}, {"t": "Viel", "s": 20.629, "e": 21.086}, {"t": "Deutsch!", "s": 21.102, "e": 21.681}], "end": 22.136}, {"kind": "line", "spk": "J", "name": "Jonas", "text": "Ich kann nicht kommen. Ich muss arbeiten.", "en": "I can't come. I have to work.", "start": 22.636, "words": [{"t": "Ich", "s": 22.747, "e": 22.899}, {"t": "kann", "s": 22.945, "e": 23.082}, {"t": "nicht", "s": 23.098, "e": 23.296}, {"t": "kommen.", "s": 23.357, "e": 23.723}, {"t": "Ich", "s": 24.831, "e": 25.014}, {"t": "muss", "s": 25.045, "e": 25.273}, {"t": "arbeiten.", "s": 25.304, "e": 26.005}], "end": 27.148}, {"kind": "line", "spk": "L", "name": "Lena", "text": "Schade! Musst du den ganzen Tag arbeiten?", "en": "Too bad! Do you have to work all day?", "start": 27.648, "words": [{"t": "Schade!", "s": 27.759, "e": 28.521}, {"t": "Musst", "s": 29.569, "e": 29.935}, {"t": "du", "s": 29.95, "e": 30.133}, {"t": "den", "s": 30.148, "e": 30.392}, {"t": "ganzen", "s": 30.407, "e": 30.941}, {"t": "Tag", "s": 30.956, "e": 31.352}, {"t": "arbeiten?", "s": 31.367, "e": 32.206}], "end": 33.264}, {"kind": "line", "spk": "J", "name": "Jonas", "text": "Nein, nur bis sechs Uhr. Dann kann ich kommen.", "en": "No, only until six. Then I can come.", "start": 33.764, "words": [{"t": "Nein,", "s": 33.875, "e": 34.378}, {"t": "nur", "s": 34.576, "e": 34.805}, {"t": "bis", "s": 34.805, "e": 34.988}, {"t": "sechs", "s": 34.988, "e": 35.369}, {"t": "Uhr.", "s": 35.445, "e": 35.75}, {"t": "Dann", "s": 36.935, "e": 37.133}, {"t": "kann", "s": 37.209, "e": 37.377}, {"t": "ich", "s": 37.377, "e": 37.483}, {"t": "kommen.", "s": 37.544, "e": 37.971}], "end": 39.092}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Kann ich etwas mitbringen? Ich kann gut kochen!", "en": "Can I bring something? I can cook well!"