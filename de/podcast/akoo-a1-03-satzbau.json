 38.159, "e": 38.448}, {"t": "Uhr.", "s": 38.509, "e": 38.845}], "end": 40.02}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Und wie viel kostet das Ticket?", "en": "And how much does the ticket cost?", "start": 40.52, "words": [{"t": "Und", "s": 40.57, "e": 40.921}, {"t": "wie", "s": 40.936, "e": 41.134}, {"t": "viel", "s": 41.149, "e": 41.469}, {"t": "kostet", "s": 41.485, "e": 42.018}, {"t": "das", "s": 42.033, "e": 42.262}, {"t": "Ticket?", "s": 42.277, "e": 42.933}], "end": 43.376}, {"kind": "line", "spk": "J", "name": "Jonas", "text": "Das Ticket kostet drei Euro.", "en": "The ticket costs three euros.", "start": 43.876, "words": [{"t": "Das", "s": 43.987, "e": 44.185}, {"t": "Ticket", "s": 44.2, "e": 44.551}, {"t": "kostet", "s": 44.627, "e": 45.054}, {"t": "drei", "s": 45.085, "e": 45.374}, {"t": "Euro.", "s": 45.45, "e": 45.923}], "end": 47.116}, {"kind": "line", "spk": "K", "name": "Kofi", "text": "Am Montag arbeite ich wieder. Aber heute lerne ich Berlin!", "en": "On Monday I work again. But today I'm learning Berlin!", "start": 47.616, "words": [{"t": "Am", "s": 47.666, "e": 47.971}, {"t": "Montag", "s": 47.986, "e": 48.718}, {"t": "arbeite", "s": 48.733, "e": 49.312}, {"t": "ich", "s": 49.328, "e": 49.51}, {"t": "wieder.", "s": 49.526, "e": 50.029}, {"t": "Aber", "s": 50.471, "e": 50.913}, {"t": "heute", "s": 50.928, "e": 51.37}, {"t": "lerne", "s": 51.386, "e": 51.873}, {"t": "ich", "s": 51.889, "e": 52.056}, {"t": "Berlin!", "s": 52.072, "e": 52.788}], "end": 53.232}, {"kind": "pause", "dur": 1.0, "start": 53.732, "end": 54.732}, {"kind": "section", "text": "Was hast du gehört?", "start": 54.732, "end": 54.732}, {"kind": "host", "spk": "H", "name": "Host", "text": "Listen to where the verb goes. Kofi starts with today.", "en": "", "start": 54.732, "words": [{"t": "Listen", "s": 54.861, "e": 55.295}, {"t": "to", "s": 55.308, "e": 55.44}, {"t": "where", "s": 55.453, "e": 55.69}, {"t": "the", "s": 55.703, "e": 55.821}, {"t": "verb", "s": 55.835,